{
  "name": "@headlessoracle/receipt-verify",
  "version": "0.1.2",
  "description": "Cross-format agent-receipt verifier. Recomputes and returns a tri-state verdict per receipt, under a named format.",
  "license": "Apache-2.0",
  "author": "Michael Msebenzi",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "receipt-verify": "dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LembaGang/receipt-verify.git"
  },
  "homepage": "https://github.com/LembaGang/receipt-verify#readme",
  "scripts": {
    "prepublishOnly": "node tools/release-guard.mjs && npm run typecheck && npm run build && npm test",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "snapshot": "node tools/snapshot.mjs",
    "fixtures": "node tools/make-throwaway-fixtures.mjs",
    "cli": "tsx src/cli.ts",
    "walk": "tsx tools/walk-digests.ts"
  },
  "dependencies": {
    "@headlessoracle/chirindo": "0.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "canonicalize": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
