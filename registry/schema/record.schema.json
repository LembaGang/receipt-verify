{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LembaGang/receipt-verify/registry/schema/record.schema.json",
  "title": "receipt-verify registry record",
  "description": "One record of one executed verification. Closed: every vocabulary is an enum and no member outside this document is accepted, so a reader that branches on a value here can rely on the set of values it may see. The schema fixes SHAPE and never TRUTH: a record can validate perfectly and still describe a run nobody made, which is what the executed_run outputs, the pinned inputs and the named consenting human are for. Rules that are about the git history rather than about the document (a record's immutability after publication, the index chain) are not expressible here and live in tools/registry.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "record_type",
    "key",
    "subject",
    "assessor",
    "consent",
    "methodology",
    "method",
    "executed_run",
    "pinned_inputs",
    "as_of",
    "not_established",
    "establishes",
    "independent_rerun",
    "review_window",
    "reply",
    "status",
    "supersedes",
    "superseded_by",
    "supersession_reason",
    "report"
  ],
  "properties": {
    "schema": { "const": "receipt-verify/registry-record/0" },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9.-]*$",
      "description": "<verified_at date>-<slug>. The slug comes from the key, never from a vendor name alone."
    },
    "kind": {
      "enum": ["entry", "own_work", "observation"],
      "description": "entry: a graded party's format, published after a review window. own_work: the operator's own artefact. observation: built from public bytes about a party who has not consented, and never called an entry."
    },
    "record_type": { "enum": ["conformance_entry", "dispute_package", "finding", "observation"] },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "upstream_digest", "verifier", "verified_at"],
      "description": "The five members a record is keyed on. No vendor name is among them.",
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "format_version": { "type": "string", "minLength": 1 },
        "upstream_digest": { "$ref": "#/$defs/digest" },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "version", "commit"],
          "properties": {
            "tool": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              ],
              "description": "One tool, or the several that together did the run."
            },
            "version": { "type": "string", "minLength": 1 },
            "commit": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }] }
          }
        },
        "verified_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)?$" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "artefact", "artefact_digest", "role", "named_party"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "artefact": { "type": "string", "minLength": 1 },
        "artefact_digest": { "$ref": "#/$defs/digest" },
        "role": { "enum": ["emitter", "verifier", "emitter_and_verifier", "facilitator", "payer", "not_applicable"] },
        "named_party": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }],
          "description": "Null on an observation, always: naming a party who has not consented is the thing the kind exists to forbid."
        }
      }
    },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "affiliation"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "affiliation": { "type": "string", "minLength": 1 }
      }
    },
    "consent": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["named_human", "affiliation", "given_on", "channel", "scope"],
          "properties": {
            "named_human": { "type": "string", "minLength": 1 },
            "affiliation": { "type": "string", "minLength": 1 },
            "given_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "channel": { "type": "string", "minLength": 1 },
            "scope": { "type": "string", "minLength": 1 }
          }
        },
        { "type": "null" }
      ],
      "description": "Required non-null on entry and own_work; required null on observation. Enforced by tools/registry.ts rule 1, which can see the kind."
    },
    "methodology": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["document", "version", "sha256"],
          "properties": {
            "document": { "type": "string", "pattern": "^methodology/[A-Za-z0-9._-]+\\.md$" },
            "version": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256hex" }
          }
        },
        { "type": "null" }
      ],
      "description": "Required non-null for record_type conformance_entry, where document is the registry/methodology/ file the report names."
    },
    "method": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }],
      "description": "Required non-null for dispute_package, finding and observation: the README section or the report shape the record follows."
    },
    "executed_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "run_at", "tool_commit", "outputs"],
      "properties": {
        "command": { "type": "string" },
        "run_at": { "type": "string", "minLength": 1 },
        "tool_commit": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }] },
        "outputs": {
          "type": "array",
          "description": "The run's own output files, at repository-relative paths, recomputed by the build.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256hex" },
              "bytes": { "type": "integer" }
            }
          }
        }
      }
    },
    "pinned_inputs": {
      "type": "array",
      "description": "Every path in a record is REPOSITORY-relative, so a reader can fetch it at the commit the citation table names without first working out what it is relative to. in_tree entries must exist at that path and hash to sha256; the build recomputes them. external entries carry path null, are listed and never checked, because the bytes are not here to check.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "location", "sha256", "bytes", "source", "retrieved_at", "holder"],
        "properties": {
          "path": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
          "location": { "enum": ["in_tree", "external"] },
          "sha256": { "$ref": "#/$defs/sha256hex" },
          "bytes": { "type": "integer" },
          "source": { "type": "string", "minLength": 1 },
          "retrieved_at": { "type": "string", "minLength": 1 },
          "holder": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
        }
      }
    },
    "as_of": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_digest", "date"],
      "properties": {
        "upstream_digest": { "$ref": "#/$defs/digest" },
        "date": { "type": "string", "minLength": 1 }
      }
    },
    "not_established": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Non-empty, always: a record that names nothing it failed to establish is making a claim about everything. The emptiness is checked by rule 4 in tools/registry.ts rather than by minItems here, so that the refusal NAMES the rule instead of reading as a shape error."
    },
    "establishes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "independent_rerun": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "date", "pointer"],
          "properties": {
            "by": { "type": "string", "minLength": 1 },
            "date": { "type": "string", "minLength": 1 },
            "pointer": { "type": "string", "minLength": 1 }
          }
        },
        { "type": "null" }
      ]
    },
    "review_window": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sent_on", "closes_on", "outcome"],
          "properties": {
            "sent_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "closes_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "outcome": { "enum": ["replied", "lapsed"] }
          }
        },
        { "type": "null" }
      ]
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "date", "pointer", "text_sha256"],
      "properties": {
        "kind": { "enum": ["none", "reproduced", "disputed", "corrected"] },
        "date": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "pointer": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "text_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256hex" }, { "type": "null" }] }
      }
    },
    "status": { "enum": ["published", "superseded"] },
    "supersedes": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "superseded_by": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "supersession_reason": {
      "anyOf": [
        { "type": "array", "items": { "enum": ["artefact_changed", "assessment_error"] } },
        { "type": "null" }
      ],
      "description": "Non-null and non-empty only when supersedes is non-null, which rule 3 in tools/registry.ts checks so that the refusal names the rule. One record may carry both reasons: a new artefact version and a correction of the earlier assessment are distinct events and the methodology keeps them distinct."
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "description": "The human report, carried byte for byte. Repository-relative, like every path in a record.",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256hex" },
        "bytes": { "type": "integer" }
      }
    }
  },
  "$defs": {
    "sha256hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "value"],
      "description": "alg names the function; value is its output in that function's published spelling (hex for sha256, base64 for the sha512 an npm integrity string carries). The spelling is part of the value, so a reader recomputing it knows which form to compare.",
      "properties": {
        "alg": { "enum": ["sha256", "sha512", "sha1", "keccak256"] },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
